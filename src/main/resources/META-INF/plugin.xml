<idea-plugin>
    <id>com.github.ttereshchenko.mailkit</id>
    <name>MailKit</name>
    <vendor email="plugin.mailkit@gmail.com" url="https://github.com/ttereshchenko/mailkit">Taras Tereshchenko</vendor>
    <description><![CDATA[
        <p>Syntax highlighting, code folding, and editor support for EML (Email Message / RFC 822) files.</p>
        <ul>
          <li>Syntax highlighting for headers, MIME boundaries, and body content</li>
          <li>MIME part code folding — collapse and expand nested message parts</li>
          <li>Per-header color customization via the color scheme editor</li>
          <li>Name-only highlighting mode (highlight header name, not value)</li>
          <li>Global highlighting toggle under Settings → Editor → MailKit</li>
          <li>Add custom headers to the highlight list</li>
          <li>Save attachments to disk or open them with the system app — gutter icon and editor context menu on any qualifying MIME part, with base64 / quoted-printable / 7bit / 8bit / binary decoding</li>
          <li>EML inspections — RFC 5322 / MIME violations are flagged inline with Alt+Enter quick-fixes (missing required headers, unterminated MIME boundaries, base64 alphabet errors, charset mismatches, unparseable dates, and more)</li>
          <li>MSG → EML conversion — right-click an Outlook <code>.msg</code> file in the Project view to convert it to a standards-compliant <code>.eml</code> with header mapping, body selection, attachment handling, and recursive embedded-message support</li>
          <li>Send EML — swaks-equivalent embedded client (STARTTLS / TLS-on-connect, SASL incl. SCRAM-SHA-256, ESMTP extensions, XCLIENT, HAProxy PROXY v1/v2) with per-send envelope override, live tool-window transcript, and PasswordSafe-backed profiles under Settings → Tools → MailKit SMTP</li>
        </ul>
        <p><a href="https://github.com/ttereshchenko/mailkit">Source Code</a> | <a href="https://www.buymeacoffee.com/ttereshchenko">Donation</a></p>
    ]]></description>
    <idea-version since-build="253"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="EML"
                  language="EML"
                  implementationClass="com.github.ttereshchenko.mailkit.EmlFileType"
                  fieldName="INSTANCE"
                  extensions="eml"/>

        <fileType name="MSG"
                  implementationClass="com.github.ttereshchenko.mailkit.conversion.msg.MsgFileType"
                  fieldName="INSTANCE"
                  extensions="msg"/>

        <lang.parserDefinition
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.lexer.EmlParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.highlighting.EmlSyntaxHighlighterFactory"/>

        <lang.foldingBuilder
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.folding.EmlFoldingBuilder"/>

        <applicationService serviceImplementation="com.github.ttereshchenko.mailkit.settings.EmlHeaderSettings"/>
        <applicationService serviceImplementation="com.github.ttereshchenko.mailkit.smtp.profile.SmtpProfileService"/>

        <annotator language="EML" implementationClass="com.github.ttereshchenko.mailkit.highlighting.EmlHeaderAnnotator"/>

        <applicationConfigurable parentId="editor" id="eml.settings"
                displayName="MailKit" instance="com.github.ttereshchenko.mailkit.settings.EmlHeaderSettingsConfigurable"/>

        <applicationConfigurable parentId="tools" id="mailkit.smtp.settings"
                displayName="MailKit SMTP" instance="com.github.ttereshchenko.mailkit.smtp.ui.SmtpSettingsConfigurable"/>

        <colorSettingsPage implementation="com.github.ttereshchenko.mailkit.highlighting.EmlColorSettingsPage"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/EmlDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/EmlDarcula.xml"/>

        <codeInsight.lineMarkerProvider
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.attachment.SaveAttachmentLineMarkerProvider"/>

        <notificationGroup id="MailKit" displayType="BALLOON"/>

        <toolWindow id="MailKit SMTP" anchor="bottom" icon="AllIcons.Actions.Lightning"
                factoryClass="com.github.ttereshchenko.mailkit.smtp.ui.SmtpConsoleToolWindowFactory"/>

        <localInspection language="EML" groupName="MailKit" shortName="MissingRequiredHeader"
                displayName="Missing required header" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.MissingRequiredHeaderInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="LineTooLong"
                displayName="Line exceeds 998 octets" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.LineTooLongInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="UnterminatedBoundary"
                displayName="Unterminated MIME boundary" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.UnterminatedBoundaryInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="BoundaryNeedsQuoting"
                displayName="MIME boundary needs quoting" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.BoundaryNeedsQuotingInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="UnencodedNonAsciiHeader"
                displayName="Unencoded non-ASCII in structured header" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.UnencodedNonAsciiHeaderInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="InvalidBase64Body"
                displayName="Invalid base64 body" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.InvalidBase64BodyInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="CharsetMismatch"
                displayName="Declared charset cannot decode body" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.CharsetMismatchInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="UnparseableDate"
                displayName="Unparseable Date header" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.UnparseableDateInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="DuplicateMessageId"
                displayName="Duplicate Message-ID header" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.DuplicateMessageIdInspection"/>
        <localInspection language="EML" groupName="MailKit" shortName="UnknownContentTransferEncoding"
                displayName="Unknown Content-Transfer-Encoding" enabledByDefault="true" level="WARNING"
                implementationClass="com.github.ttereshchenko.mailkit.inspections.tools.UnknownContentTransferEncodingInspection"/>
    </extensions>

    <actions>
        <action id="mailkit.SaveAttachment"
                class="com.github.ttereshchenko.mailkit.attachment.SaveAttachmentAction"
                text="Save Attachment As…"
                description="Decode the enclosing MIME part and save it to disk">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="mailkit.OpenAttachmentWithSystemApp"
                class="com.github.ttereshchenko.mailkit.attachment.OpenAttachmentWithSystemAppAction"
                text="Open Attachment with System App"
                description="Decode the enclosing MIME part to a temp file and hand it to the OS">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="mailkit.SaveAttachment"/>
        </action>
        <action id="mailkit.ConvertMsgToEml"
                class="com.github.ttereshchenko.mailkit.conversion.msg.ConvertMsgToEmlAction"
                text="Convert to EML"
                description="Convert the selected Outlook MSG file to a standards-compliant EML file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="mailkit.SendViaSmtp"
                class="com.github.ttereshchenko.mailkit.smtp.ui.SendViaSmtpAction"
                text="Send EML…"
                description="Send this EML message through a configured SMTP server">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="mailkit.ShowRecentSmtpSends"
                class="com.github.ttereshchenko.mailkit.smtp.ui.ShowRecentSmtpSendsAction"
                text="Show Recent SMTP Sends…"
                description="Open the audit log of past SMTP sends from this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
