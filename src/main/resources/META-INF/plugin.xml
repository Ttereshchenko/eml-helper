<idea-plugin>
    <id>com.github.ttereshchenko.mailkit</id>
    <name>MailKit</name>
    <vendor email="" url="https://github.com/ttereshchenko/mailkit">ttereshchenko</vendor>
    <description><![CDATA[
        <p>Syntax highlighting, code folding, and editor support for EML (Email Message / RFC 822) files.</p>
        <ul>
          <li>Syntax highlighting for headers, MIME boundaries, and body content</li>
          <li>MIME part code folding — collapse and expand nested message parts</li>
          <li>Per-header color customization via the color scheme editor</li>
          <li>Name-only highlighting mode (highlight header name, not value)</li>
          <li>Global highlighting toggle under Settings → Editor → EML</li>
          <li>Add custom headers to the highlight list</li>
        </ul>
    ]]></description>
    <idea-version since-build="253"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="EML"
                  language="EML"
                  implementationClass="com.github.ttereshchenko.mailkit.EmlFileType"
                  fieldName="INSTANCE"
                  extensions="eml"/>

        <lang.parserDefinition
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.lexer.EmlParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.highlighting.EmlSyntaxHighlighterFactory"/>

        <lang.foldingBuilder
                language="EML"
                implementationClass="com.github.ttereshchenko.mailkit.folding.EmlFoldingBuilder"/>

        <applicationService serviceImplementation="com.github.ttereshchenko.mailkit.settings.EmlHeaderSettings"/>

        <annotator language="EML" implementationClass="com.github.ttereshchenko.mailkit.highlighting.EmlHeaderAnnotator"/>

        <applicationConfigurable parentId="editor" id="eml.settings"
                displayName="EML" instance="com.github.ttereshchenko.mailkit.settings.EmlHeaderSettingsConfigurable"/>

        <colorSettingsPage implementation="com.github.ttereshchenko.mailkit.highlighting.EmlColorSettingsPage"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/EmlDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/EmlDarcula.xml"/>
    </extensions>
</idea-plugin>
